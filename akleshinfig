        if name:lower() == mapName:lower() then
            toggle:Set(true)
            return
        end
    end
end

-- Helper: Get Lake Capacity
local function getLakeCapacity(lake)
    if not lake or not lake.Parent then return 0 end
    local attr = lake:GetAttribute("capacity") or lake:GetAttribute("Capacity")
    if attr ~= nil then return tonumber(attr) or 0 end
    local child = lake:FindFirstChild("capacity") or lake:FindFirstChild("Capacity") or lake:FindFirstChild("Amount")
    return (child and child.Value) or 100
end

-- Helper: Target Closest Lake
local function selectBestLakeInMap(areaFolder)
    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not areaFolder then return nil end
    
    local lkF = getLakesFolder(areaFolder)
    local nearest, minDist = nil, math.huge
    
    for _, l in lkF:GetChildren() do
        if l:IsA("Model") or l:IsA("BasePart") then
            if getLakeCapacity(l) > 0 then
                local dist = (hrp.Position - l:GetPivot().Position).Magnitude
                if dist < minDist then minDist, nearest = dist, l end
            end
        end
    end
    cfg.lake = nearest
    return nearest
end

-- Teleport Logic (Right Offset + Fixed 20 Studs Height + Toggleable Platform)
local function teleportToLake(lake, hrp)
    if not lake or not hrp then return end
    local targetCF = lake:GetPivot() * CFrame.new(cfg.offset, 20, 0)
    local floatPart = workspace:FindFirstChild("LakeInvisibleFloor")
    local camoActive = cfg.distanceCamo and not isSelling and isPlayerNearby(cfg.camoDist)

    if cfg.platform and not camoActive then
        if not floatPart then
            floatPart = Instance.new("Part")
            floatPart.Name = "LakeInvisibleFloor"
            floatPart.Size = Vector3.new(5, 1, 5)
            floatPart.Transparency = 1
            floatPart.Anchored = true
            floatPart.CanCollide = true
            floatPart.Parent = workspace
        end
        floatPart.CFrame = targetCF * CFrame.new(0, -3.5, 0)
    else
        if floatPart then floatPart:Destroy() end
    end

    hrp.CFrame = targetCF
end

-- Server Hop Logic (Includes visited server filtering to avoid rejoining bad servers)
local function serverHop()
    if isHopping then return end
    isHopping = true

    task.spawn(function()
        while true do
            local success, result = pcall(function()
                return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
            end)

            if success and result and result.data then
                local idealServers, backupServers = {}, {}

                for _, server in ipairs(result.data) do
                    if type(server) == "table" and server.id ~= game.JobId and not getgenv().VisitedServers[server.id] and server.playing and server.maxPlayers then
                        if server.playing >= 2 and server.playing <= 3 then
                            table.insert(idealServers, server.id)
                        elseif server.playing > 3 and server.playing < server.maxPlayers then
                            table.insert(backupServers, server.id)
                        end
                    end
                end

                -- Reset visited servers cache if no unvisited options remain
                if #idealServers == 0 and #backupServers == 0 then
                    getgenv().VisitedServers = { [game.JobId] = true }
                    for _, server in ipairs(result.data) do
                        if type(server) == "table" and server.id ~= game.JobId and server.playing and server.maxPlayers then
                            if server.playing >= 2 and server.playing <= 3 then
                                table.insert(idealServers, server.id)
                            elseif server.playing > 3 and server.playing < server.maxPlayers then
                                table.insert(backupServers, server.id)
                            end
                        end
                    end
                end

                local targetList = #idealServers > 0 and idealServers or backupServers
                if #targetList > 0 then
                    for _, serverId in ipairs(targetList) do
                        getgenv().VisitedServers[serverId] = true
                        pcall(saveVisitedServers)
                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, plr)
                        end)
                        task.wait(4)
                    end
                end
            end
            task.wait(3)
        end
    end)
end

-- Auto-Lock Logic (Using resolved Flamework Controller)
local function lockSelectedFishes()
    if not fishInvCtrl or not fishMgr then
        pcall(function()
            Runtime = Runtime or require(ReplicatedStorage:WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
            Flamework = Flamework or Runtime.import(script, ReplicatedStorage, "rbxts_include", "node_modules", "@flamework", "core", "out").Flamework
            fishInvCtrl = fishInvCtrl or Flamework.resolveDependency("x5")
            fishMgr = fishMgr or Flamework.resolveDependency("LY")
        end)
        if not fishInvCtrl or not fishMgr then return end
    end

    local ok, fishes = pcall(function() return fishInvCtrl:getFishes() end)
    if not ok or type(fishes) ~= "table" then return end

    for id, fishData in pairs(fishes) do
        if not fishData.locked then
            local defOk, fishDef = pcall(function() return fishMgr:getByName(fishData.name) end)
            if defOk and fishDef and fishDef.rarity then
                local rarityName = fishDef.rarity.name or fishDef.rarity.displayName
                if rarityName then
                    local normKey = string.lower(rarityName):gsub("[%s%-_]", "")
                    if normKey == "mythical" then normKey = "mythic" end -- Mythic alias fix
                    if cfg.favRarities[normKey] then
                        pcall(function()
                            fishInvCtrl:lock(id)
                        end)
                    end
                end
            end
        end
    end
end

