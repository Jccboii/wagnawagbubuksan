-- Helper: Case-insensitive Lakes folder check
local function getLakesFolder(areaFolder)
    if not areaFolder then return nil end
    return areaFolder:FindFirstChild("Lakes") or areaFolder:FindFirstChild("lakes") or areaFolder
end

-- Helper: Convert "1.5k" -> 1500
local function parseNum(str)
    if type(str) ~= "string" then return 0 end
    local num, suf = str:lower():gsub(",", ""):match("([%d%.]+)([kmbt]?)")
    return (tonumber(num) or 0) * (mults[suf] or 1)
end

-- Helper: Save Visited Servers across teleport
local function saveVisitedServers()
    local queueTeleport = (syn and syn.queue_on_teleport) or queue_on_teleport or (fluxus and fluxus.queue_on_teleport)
    if queueTeleport then
        pcall(function()
            local json = HttpService:JSONDecode(getgenv().VisitedServers)
            queueTeleport("getgenv().VisitedServers = game:GetService('HttpService'):JSONDecode('" .. json .. "')")
        end)
    end
end

-- Helper: Check Backpack
local function isBackpackFull()
    local hud = plr:FindFirstChild("PlayerGui") and plr.PlayerGui:FindFirstChild("MobileHud")
    local lbl = hud and hud:FindFirstChild("Bottom") and hud.Bottom:FindFirstChild("Hotbar") and hud.Bottom.Hotbar:FindFirstChild("Bucket") and hud.Bottom.Hotbar.Bucket:FindFirstChild("Amount")
    if lbl and lbl:IsA("TextLabel") then
        local cur, max = lbl.Text:match("([^/]+)/([^/]+)")
        return cur and max and parseNum(max) > 0 and parseNum(cur) >= parseNum(max)
    end
    return false
end

-- Helper: Check nearby players
local function isPlayerNearby(dist)
    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= plr and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude <= dist then
                return true
            end
        end
    end
    return false
end

-- Helper: Switch UI and Selected Map
