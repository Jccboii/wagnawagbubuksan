local function mtype(m)
local a=m:FindFirstChild("Attrs")
local h=a and a:FindFirstChild("5")
if not h then return end
if h.Value==3000 then
local a1=a:FindFirstChild("1")
return(a1 and a1.Value==60)and"Archer Goblin"or"Warhammer Dwarf"
end
return HP_MAP[h.Value]
end

local function alive(m)
local h=m and m:FindFirstChildOfClass("Humanoid")
return h and m:FindFirstChild("HumanoidRootPart")and h.Health>0
end

