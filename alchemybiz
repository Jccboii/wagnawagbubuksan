local function ename(z)local o,n=pcall(LC.FormatByKey,z)return(o and n~="")and n or nil end
local function bag(id)local b=PD.GetPlrDataByKey(LP,{"Bag"})if type(b)~="table"then return nil,0 end for _,v in pairs(b)do if tonumber(v.id)==id then local c=tonumber(v.count)or 0 if c>0 then return tonumber(v.onlyID),c end end end return nil,0 end
local function sell(oid,cnt)pcall(function()RF:InvokeServer("\229\135\186\229\148\174\232\131\140\229\140\133\231\137\169\229\147\129",{onlyIDList={oid},countList={cnt}})end)end
local function brew(r)
pcall(function()RF:InvokeServer("炼药游戏开始",{cauldronID=8000001,materials=r.materials})end)
pcall(function()MsgRE:FireServer("\231\130\188\232\141\175\230\184\184\230\136\143\231\187\147\230\157\159")end)
end

