local function valid(m)return not next(targetSel)or targetSel[mtype(m)]end

local function nextMob()
local f
for _,m in pairs(MonsterFolder:GetChildren())do
if alive(m)then
if valid(m)then return m end
f=f or m
end
end
return not next(targetSel)and f or nil
end

local function fireBlock(mon,tr)
task.spawn(function()
if not HRP or not tr then return end
local id=HttpService:GenerateGUID(false)
local t={
targetCF=tr.CFrame,
releaseCF=HRP.CFrame,
moveDirectionStr="Forward",
characterType="Player",
characterId=LP.UserId,
trackTargetId=tostring(mon.Name),
clientPredictCastId=id
}
pcall(SkillRE.FireServer,SkillRE,5,t)
task.wait(.35)
t.clientPredictCastId=nil
t.skillButtonPhase="up"
t.skillCastId=id
pcall(SkillRE.FireServer,SkillRE,5,t)
end)
end

local function disconnectBlock()
if blockConn then blockConn:Disconnect()blockConn=nil end
end

local function connectBlock(mon)
disconnectBlock()
if not blockOn or not mon then return end
local a=mon:FindFirstChildOfClass("Humanoid")
a=a and a:FindFirstChildOfClass("Animator")
if not a then return end
blockConn=a.AnimationPlayed:Connect(function(t)
if t.Name:find("1$")then
task.delay(blockDelay,function()
if blockOn and target==mon and alive(mon)then fireBlock(mon,root)end
end)
end
end)
end

local function stopFarm()
if farmConn then farmConn:Disconnect()farmConn=nil end
disconnectBlock()
target=nil
root=nil
platform.CFrame=CFrame.new(0,-500,0)
end

local function startFarm()
stopFarm()
local tm=0
farmConn=RunService.Heartbeat:Connect(function(dt)
tm+=dt
if tm>=.5 or not alive(target)or not valid(target)then
tm=0
local p=target
target=nextMob()
if target~=p then
root=target and target:FindFirstChild("HumanoidRootPart")
connectBlock(target)
end
end
if root and alive(target)then
local pos=root.Position+Vector3.new(0,height,0)
platform.CFrame=CFrame.new(pos)
if HRP and(HRP.Position-pos).Magnitude>20 then
HRP.CFrame=CFrame.new(pos+Vector3.new(0,3,0))
end
end
end)
end

